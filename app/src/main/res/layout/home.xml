<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity" >


    <ImageView
        android:id="@+id/ivHomePou"
        android:layout_width="407dp"
        android:layout_height="734dp"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/pouhome"
        tools:layout_editor_absoluteY="-1dp"
        tools:ignore="MissingConstraints" />

    <LinearLayout
        android:layout_width="413dp"
        android:layout_height="145dp"
        android:background="#F47977"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivHomePou"
        app:layout_constraintVertical_bias="1.0">

        <ImageButton
            android:id="@+id/ibPlayground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#F47977"
            android:contentDescription="futbol"
            app:srcCompat="@drawable/futbol" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>